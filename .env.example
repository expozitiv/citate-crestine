# === Baza de date (Supabase PostgreSQL) ===
# Supabase → Project Settings → Database → Connection string (Transaction pooler, port 6543, pentru Vercel)
# Local (docker): postgresql://postgres:postgres@localhost:5432/citate
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/citate

# === Payload ===
# Cheie secretă pentru sesiuni/criptare — generează cu: openssl rand -hex 32
PAYLOAD_SECRET=8Q4dGvCVBLjUdXw9BHZf2Gx/sGi1Cbi2Bos3uzfGF10=

# URL-ul public al site-ului (fără trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# === Supabase Storage (S3-compatible) — pentru imaginile autorilor ===
# Supabase → Project Settings → Storage → S3 access keys. Bucket-ul trebuie creat manual (public).
# Dacă lipsesc, Payload salvează local în ./media (doar pentru dezvoltare — NU pe Vercel).
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=

# === Cloudflare R2 (privat) — media kit-ul, descărcabil doar din admin (/admin/media-kit) ===
# Cloudflare → R2 → Manage API tokens → token „Object Read only” limitat la bucket.
# Account ID: R2 → Overview (dreapta). Fișierul din bucket: media-kit.zip.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=citate-crestine-privat

# Token opțional pentru protejarea endpoint-ului de revalidare manuală
REVALIDATE_TOKEN=

# Google Analytics 4 (doar în producție); gol = dezactivat
NEXT_PUBLIC_GA_ID=G-WTZKMWGT7W
